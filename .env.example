# --- BookStack upstream credentials ---
# Base URL of your BookStack instance (no trailing slash).
BOOKSTACK_URL=https://wiki.example.com

# An API token pair issued in BookStack: Edit Profile -> API Tokens.
BOOKSTACK_AUTH_ID=
BOOKSTACK_AUTH_TOKEN=

# --- MCP server OAuth ---
# Secret used to sign the JWT access/refresh tokens this server issues to AI clients.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Master password the user types on the consent screen when a new AI client
# (Claude Code, ChatGPT, etc.) requests authorization. Single-user mode.
OAUTH_PW=

# --- Local bind address (reverse proxy terminates TLS) ---
# Server always binds 127.0.0.1; only the port is configurable. Defaults to 3000.
LOCAL_SERVER_PORT=3000

# Required. Public HTTPS URL the reverse proxy exposes. Used as the OAuth issuer
# and JWT audience (RFC 8707), so it must exactly match what clients see.
PUBLIC_URL=https://bookstack-mcp.example.com
